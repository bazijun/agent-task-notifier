# iPhone/iPad 可用 Bark；Android 推荐 ntfy，也可使用其他已支持的渠道。渠道凭据写入 notify.env。
# 空值不启用对应渠道；进程环境中的同名变量优先于本文件。
FEISHU_WEBHOOK_URL=
FEISHU_SECRET=

BARK_SERVER=https://api.day.app
BARK_DEVICE_KEY=
# 优先绑定 macOS 物理网卡直连 Bark；失败后使用受系统路由影响的 HTTPS 回退。
BARK_DIRECT=1
# 可选覆盖；留空时自动识别网卡，并依次尝试内置 DNS。
BARK_DIRECT_INTERFACE=
BARK_DIRECT_DNS=
BARK_DIRECT_IPS=
BARK_LEVEL=active
BARK_GROUP=Codex
BARK_ICON=https://cdn.jsdelivr.net/gh/ilysenko/codex-desktop-linux@main/assets/codex.png
# 可选：系统通知跳转链接；历史消息中的链接及文字。
BARK_OPEN_URL=
BARK_HISTORY_URL=
BARK_HISTORY_LINK_TEXT=
BARK_SOUND=

# 可选通道
WECOM_WEBHOOK_URL=
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
WXPUSHER_APP_TOKEN=
WXPUSHER_UIDS=
IMESSAGE_TARGET=
